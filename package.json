{
  "name": "key-event-plus",
  "version": "2.0.0",
  "description": "Tiny, zero-dependency keyboard listener with full TypeScript types and international layout support",
  "keywords": [
    "keyboard",
    "key",
    "event",
    "eventlistener",
    "keydown",
    "keyup",
    "hotkey",
    "shortcut",
    "keyboard-layout",
    "typescript"
  ],
  "homepage": "https://jeeanribeiro.github.io/key-event-plus/",
  "bugs": {
    "url": "https://github.com/jeeanribeiro/key-event-plus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeeanribeiro/key-event-plus.git"
  },
  "license": "MIT",
  "author": "Jean Ribeiro <contact@jeanribeiro.dev>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:demo": "vite build demo",
    "capture": "pnpm build:demo && node scripts/capture.mjs",
    "coverage": "vitest run --coverage",
    "dev": "vite demo",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "preview": "vite preview demo",
    "release": "pnpm build && changeset publish",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.61.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.0",
    "prettier": "^3.9.5",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.3",
    "tsup": "8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.1.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
